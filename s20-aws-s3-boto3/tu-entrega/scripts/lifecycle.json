{
  "Rules": [
    {
      "ID": "R1-abortar-multipart-incompletos-7d",
      "Status": "Enabled",
      "Filter": {},
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    },
    {
      "ID": "R2a-tmp-expirar-actuales-y-no-actuales-1d",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "tmp/"
      },
      "Expiration": {
        "Days": 1
      },
      "NoncurrentVersionExpiration": {
        "NoncurrentDays": 1
      }
    },
    {
      "ID": "R2b-tmp-limpiar-delete-markers-huerfanos",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "tmp/"
      },
      "Expiration": {
        "ExpiredObjectDeleteMarker": true
      }
    },
    {
      "ID": "R3a-staging-expirar-no-actuales-30d",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "staging/"
      },
      "NoncurrentVersionExpiration": {
        "NoncurrentDays": 30
      }
    },
    {
      "ID": "R3b-curated-expirar-no-actuales-30d",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "curated/"
      },
      "NoncurrentVersionExpiration": {
        "NoncurrentDays": 30
      }
    }
  ]
}
