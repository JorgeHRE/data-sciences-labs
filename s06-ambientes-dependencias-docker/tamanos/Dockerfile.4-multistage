# --- Etapa 1: Construcción (builder) ---
FROM python:3.12-slim AS builder

WORKDIR /app

# Crear el entorno virtual
RUN python -m venv /app/.venv

# Activar el .venv para los siguientes RUN
ENV PATH="/app/.venv/bin:$PATH"

# Copiar el proyecto (filtrado por .dockerignore)
COPY s05-buenas-practicas-pytest/ ./

# Instalar clinlab y sus dependencias dentro de /app/.venv
RUN pip install --no-cache-dir .


# --- Etapa 2: Imagen final de ejecución ---
FROM python:3.12-slim

WORKDIR /app

# Copiar ÚNICAMENTE el entorno virtual ya construido desde la etapa anterior
COPY --from=builder /app/.venv /app/.venv

# Apuntar el PATH al entorno virtual
ENV PATH="/app/.venv/bin:$PATH"

CMD ["python", "-c", "import clinlab"]