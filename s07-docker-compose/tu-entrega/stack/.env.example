# Plantilla de configuración. Uso:  cp .env.example .env   y edita los valores.
# El archivo .env NO se sube a git (está en .gitignore); este SÍ.

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=clinico
POSTGRES_DB=clinico
# Cambia esto por una clave larga. Ejemplo para generarla:  openssl rand -base64 18
# OJO: Postgres solo lee esta clave al crear el volumen por primera vez.
# Si la cambias después, hace falta "docker compose down -v" (borra los datos).
POSTGRES_PASSWORD=cambia_esto_por_una_clave_larga

# --- Jupyter -----------------------------------------------------------------
# Token para entrar a Jupyter. Ejemplo para generarlo:  openssl rand -hex 16
JUPYTER_TOKEN=cambia_esto_por_un_token_largo

# --- Puertos en TU máquina (siempre escuchan solo en 127.0.0.1) --------------
# Si alguno está ocupado ("port is already allocated"), cambia el número aquí.
POSTGRES_PORT=5432
ADMINER_PORT=8080
JUPYTER_PORT=8888
